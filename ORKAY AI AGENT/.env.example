# ─── Vobiz ───────────────────────────────────────────────────────────────────
VOBIZ_AUTH_ID=your_auth_id
VOBIZ_AUTH_SECRET=your_auth_secret
VOBIZ_FROM_NUMBER=+91XXXXXXXXXX
VOBIZ_TRUNK_ID=your_trunk_id

# ─── Sarvam AI (STT + TTS + LLM — all in one key) ───────────────────────────
SARVAM_API_KEY=your_sarvam_key

# ─── GHL (Orkay Tiles India) ─────────────────────────────────────────────────
GHL_API_KEY=your_ghl_api_key
GHL_LOCATION_ID=your_location_id

# ─── Server ──────────────────────────────────────────────────────────────────
# GitHub Codespaces: copy the forwarded port 8000 URL here
# Cloudflare: run `cloudflared tunnel --url http://localhost:8000` and copy URL
PUBLIC_BASE_URL=https://YOUR_PUBLIC_URL
PORT=8000
